# Non-secret affiliate growth configuration.
# Never place A8 credentials, cookies, real affiliate URLs, or ad-platform tokens here.
AFFILIATE_MARGIN=0.55
AFFILIATE_VERIFICATION_TTL_DAYS=30
AFFILIATE_CHANNEL=website
AFFILIATE_TRAFFIC_SOURCE=organic
AFFILIATE_HUMAN_APPROVED=false
AFFILIATE_DRY_RUN=true
AFFILIATE_TRACKING_PARAMS_ALLOWED=false
AFFILIATE_DAILY_BUDGET_YEN=3000
AFFILIATE_CUMULATIVE_LOSS_CAP_YEN=10000
AFFILIATE_MINIMUM_SAMPLE_SIZE=100
AFFILIATE_GOAL_YEN=1000000

# A8.net advertiser-side EC Sales API v3.
# Configure real values only in a local secret store or fixed-IP server environment.
A8_EC_PROGRAM_ID=
A8_EC_API_KEY=
A8_EC_ADVERTISER_ID=
A8_EC_BASE_URL=https://ecsales-api.a8.net/v3
A8_EC_TIMEOUT_SECONDS=20
A8_EC_CALLS_PER_MINUTE=240
A8_EC_MUTATIONS_ENABLED=false
A8_EC_BLOCK_MAINTENANCE_WINDOW=true
